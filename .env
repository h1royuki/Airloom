# Template for local settings. Copy this file to .env.local and fill in your own
# values: .env.local is git-ignored, this file is not.

# ADB address and port of the physical TV (a documentation-range address here).
AIRLOOM_TV=192.0.2.10:5555

# TV model as reported by `getprop ro.product.model`; the commands in AGENTS.md
# use it to confirm that the right device is connected.
AIRLOOM_TV_MODEL=EXAMPLE-TV
